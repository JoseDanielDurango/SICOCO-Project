PORT=3000
NODE_ENV=development

# ========================================================
# 1. CLOUD (MongoDB Atlas)
# ========================================================
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sicoco?retryWrites=true&w=majority

# ========================================================
# 2. LOCAL (Docker or Local MongoDB)
# ========================================================
MONGODB_URI=mongodb://localhost:27017/sicoco

# ========================================================
# 3. SECURITY & AUTHENTICATION (JWT)
# ========================================================
JWT_SECRET=sicoco-modesec-super-secret-key-2026
JWT_EXPIRES_IN=24h

# ========================================================
# 4. OBSERVABILITY & TELEMETRY
# ========================================================
OBSERVE_APP_KEY=YOUR_OBSERVE_APP_KEY
OBSERVE_APP_SECRET=YOUR_OBSERVE_APP_SECRET
