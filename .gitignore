# ==========================================
# SICOCO Project Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compiled Output & Builds
dist/
*/dist/
build/
*/build/

# TypeScript Cache
*.tsbuildinfo
*/tsconfig.build.tsbuildinfo

# Environment & Secret Variables
.env
*.env
!.env.example
*/*.env
!*/.env.example

# Local Git Backups
.git_backup/
*/.git_backup/

# Logs
logs/
*.log

# OS & Temporary Files
.DS_Store
Thumbs.db
.temp
.tmp

# Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
